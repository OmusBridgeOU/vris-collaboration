{
  "name": "replace-worker-name",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-22",
  "account_id": "replace-account-id",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_BASE_URL": "https://vris-badge.example.com",
    "STAFF_ACCESS_USERNAME": "replace-staff-username"
  },
  "secrets": {
    "required": ["PUBLIC_TOKEN_SECRET", "STAFF_ACCESS_PASSWORD"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-database-name",
      "database_id": "replace-database-id",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ORDER_IMAGES",
      "bucket_name": "replace-order-bucket"
    }
  ]
}
